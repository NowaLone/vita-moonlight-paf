<?xml version="1.0" encoding="utf-8"?>
<resource version="0.1" type="normal" id="vita_moonlight_ui">

  <pagetable>
    <page id="page_main">
      <plane texture="_bg_texture" id="plane_main_bg">
        <layout_hint size="960, 544" />
      </plane>

      <template_ref id="template_ref_main_title" template="template_top_title_bar" />
      <template_ref id="template_ref_main_host_list" template="template_list_view_generic" />

      <text style="style_text_main_status" label="msg_select_pc" id="text_main_status">
        <layout_hint anchor="0, 2" align="0, 2" size="760, 0" pos="0, -225" adjust="0, 2" />
      </text>

      <plane style="_common_style_plane_transparent" id="plane_main_actions">
        <layout_hint anchor="0, 1" align="0, 1" size="960, 72" pos="0, 0" />
        <box style="_common_default_style_box" id="box_main_actions">
          <layout_box layout_type="2" bottom_margin="0" top_margin="0" right_margin="40" left_margin="40" />
          <button sound="_common_sound_button_enter" style="_common_default_style_button" label="msg_add_pc_placeholder" id="btn_add_pc">
            <layout_hint size="500, 60" />
          </button>
          <button sound="_common_sound_button_enter" style="_common_default_style_button" label="msg_search_pcs" id="btn_search_pcs">
            <layout_hint size="202, 60" />
          </button>
        </box>
      </plane>

      <plane style="_common_style_plane_transparent" id="plane_main_selection_actions">
        <layout_hint anchor="0, 1" align="0, 1" size="960, 72" pos="0, 0" />
        <button sound="_common_sound_button_back" style="_common_default_style_button" label="msg_cancel" id="btn_selection_cancel">
          <layout_hint anchor="1, 1" align="1, 1" size="146, 48" pos="10, 8" />
        </button>
        <button sound="_common_sound_button_enter" style="_common_default_style_button" label="msg_select_all" id="btn_selection_select_all">
          <layout_hint anchor="2, 1" align="2, 1" size="200, 48" pos="-169, 8" />
        </button>
        <button sound="_common_sound_button_enter" style="_common_default_style_button" label="msg_delete" id="btn_selection_action">
          <layout_hint anchor="2, 1" align="2, 1" size="146, 48" pos="-10, 8" />
        </button>
      </plane>

      <corner_button style="_common_style_corner_bottom_right" id="settings_button" />
    </page>

    <page id="page_search_pcs">
      <plane texture="_bg_texture" id="plane_search_bg">
        <layout_hint size="960, 544" />
      </plane>

      <template_ref id="search_title_ref" template="template_top_title_bar" />
      <template_ref id="search_list_ref" template="template_list_view_generic" />

      <text style="style_text_main_status" label="msg_searching_pcs" id="text_search_status">
        <layout_hint anchor="0, 2" align="0, 2" size="760, 0" pos="0, -220" adjust="0, 2" />
      </text>

      <corner_button style="_common_style_corner_bottom_left" id="btn_close_search" />
    </page>

    <page id="page_pairing">
      <plane texture="_bg_texture" id="plane_pairing_bg">
        <layout_hint size="960, 544" />
      </plane>

      <plane style="_common_style_plane_transparent" id="plane_pairing_root">
        <layout_hint size="960, 544" />
      </plane>

      <text style="style_text_body" label="msg_pairing_enter_pin" id="text_pairing_instruction">
        <layout_hint size="760, 0" anchor="0, 2" align="0, 2" adjust="0, 2" pos="0, 80" />
      </text>

      <text style="style_text_title" id="text_pairing_pin">
        <layout_hint size="760, 90" anchor="0, 2" align="0, 2" adjust="0, 2" pos="0, 0" />
      </text>

      <text style="style_text_main_status" id="text_pairing_status">
        <layout_hint size="760, 0" anchor="0, 2" align="0, 2" adjust="0, 2" pos="0, -80" />
      </text>

      <template_ref id="pairing_title_ref" template="template_top_title_bar" />

      <corner_button style="_common_style_corner_bottom_left" id="btn_close_pairing" />
    </page>

    <page id="page_stream">
      <plane texture="_bg_texture" id="plane_stream_video">
        <layout_hint anchor="1, 2" align="1, 2" size="960, 544" />
      </plane>
    </page>

    <page id="page_apps">
      <plane texture="_bg_texture" id="plane_apps_bg">
        <layout_hint size="960, 544" />
      </plane>

      <template_ref id="apps_title_ref" template="template_top_title_bar" />
      <template_ref id="apps_list_ref" template="template_list_view_generic" />

      <text style="style_text_main_status" label="msg_loading_apps" id="text_apps_status">
        <layout_hint anchor="0, 2" align="0, 2" size="760, 0" pos="0, -220" adjust="0, 2" />
      </text>

      <corner_button style="_common_style_corner_bottom_left" id="btn_close_apps" />
    </page>

    <page id="page_settings_bubble">
      <button sound="_common_sound_button_back" style="_common_default_style_button_transparent" id="btn_dismiss_balloon">
        <layout_hint size="960, 544" />
        <focus_hint enable="0" />
        <plane style="_common_default_style_plane" texture="_common_texture_option_menu_base_down" id="settings_speech_balloon">
          <layout_hint anchor="0, 1" align="0, 1" size="214, 12" pos="1920, 1080" />
          <text style="style_text_option_menu_ruler" id="text_option_menu_ruler">
            <layout_hint size="0, 0" adjust="2, 2" pos="1920, 1080" />
          </text>
          <box id="settings_balloon_box">
            <layout_box anchor="1, 2" align="1, 2" layout_type="1" bottom_margin="6" top_margin="6" right_margin="6" left_margin="6" />
            <button sound="_common_sound_button_enter" style="style_button_option_top" label="msg_settings" id="btn_settings_balloon">
              <layout_hint size="202, 60" />
            </button>
            <button sound="_common_sound_button_enter" style="style_button_option_middle" label="msg_copy" id="btn_copy_balloon">
              <layout_hint size="202, 60" />
              <focus_hint focus_shape="2" />
            </button>
            <button sound="_common_sound_button_enter" style="style_button_option_middle" label="msg_delete" id="btn_delete_balloon">
              <layout_hint size="202, 60" />
            </button>
            <button sound="_common_sound_button_enter" style="style_button_option_bottom" label="msg_test_speech_balloon" id="btn_test_speech_balloon">
              <layout_hint size="202, 60" />
            </button>
          </box>
        </plane>
      </button>
    </page>

    <page id="page_speech_balloon_test">
      <plane texture="_bg_texture" id="plane_speech_balloon_test_bg">
        <layout_hint size="960, 544" />
        <speech_balloon id="test_speech_balloon" />
      </plane>

      <corner_button style="_common_style_corner_bottom_left" id="btn_close_speech_balloon_test" />
    </page>
ge>
  </pagetable>

  <styletable>
    <style_plane color="0.063, 0.294, 0.655, 1" planeobj="plane_obj_fill" id="style_plane_fill">
      <planeobj color="0.063, 0.294, 0.655, 1" id="plane_obj_fill" />
    </style_plane>

    <style_text textobj="title_obj" id="style_text_title">
      <textobj font_size="36" bold="1" color="1, 1, 1, 1" align_x="1" align_y="1" ellipsis="0" emboss="0" id="title_obj" />
    </style_text>

    <style_text textobj="text_obj1" id="style_text_top_title_bar">
      <textobj font_size="32" bold="1" align_y="1" align_x="1" ellipsis="1" id="text_obj1" />
    </style_text>

    <style_text textobj="main_status_obj" id="style_text_main_status">
      <textobj font_size="22" bold="0" color="1, 1, 1, 0.90" align_x="1" align_y="1" word_wrap="1" ellipsis="1" id="main_status_obj" />
    </style_text>

    <style_list_view color="0, 0, 0, 0" id="style_list_view_generic" sbar_v_margin="6, 80, 9" />
    <style_list_item color="1, 1, 1, 0" id="style_list_view_item_generic" />

    <style_image_button layout_type_x="1" layout_type_y="0" color="1, 1, 1, 1" glow_obj="plane_obj1" label_obj="text_obj1" bg_obj="plane_obj2" image_obj="plane_obj3" image_margin="10" id="style_image_button_list_button">
      <planeobj texture0="_common_texture_list_70px" id="plane_obj2" />
      <textobj font_size="28" bold="1" max_line_count="2" enlarge_line_pitch="1" line_pitch="28" word_wrap="1" ellipsis="1" align_y="1" id="text_obj1" />
      <planeobj scale_mode_y="3" scale_mode_x="3" size="102, 70" id="plane_obj3" />
      <planeobj texture0="_common_texture_list_glow_70px" blend="2" id="plane_obj1" />
    </style_image_button>


    <style_text textobj="body_obj" id="style_text_body">
      <textobj font_size="22" bold="0" color="1, 1, 1, 0.85" align_x="1" align_y="1" word_wrap="1" ellipsis="0" emboss="0" id="body_obj" />
    </style_text>

    <style_text textobj="option_menu_ruler_obj" id="style_text_option_menu_ruler">
      <textobj font_size="28" bold="1" align_y="1" align_x="3" id="option_menu_ruler_obj" />
    </style_text>

    <style_button sound="_common_sound_button_enter" bottom_margin="12" right_margin="20" top_margin="12" left_margin="20" label_obj="label_obj" bg_obj="bg_obj" glow_obj="glow_obj" id="style_button_option_single">
      <planeobj texture0="_common_texture_option_menu_button_single" id="bg_obj" />
      <textobj font_size="28" bold="1" align_y="1" align_x="3" id="label_obj" />
      <planeobj texture0="_common_texture_option_menu_button_single_glow" blend="2" id="glow_obj" />
    </style_button>
    <style_button sound="_common_sound_button_enter" bottom_margin="12" right_margin="20" top_margin="12" left_margin="20" label_obj="label_obj" bg_obj="bg_obj" glow_obj="glow_obj" id="style_button_option_top">
      <planeobj texture0="_common_texture_option_menu_button_top" id="bg_obj" />
      <textobj font_size="28" bold="1" align_y="1" align_x="3" id="label_obj" />
      <planeobj texture0="_common_texture_option_menu_button_top_glow" blend="2" id="glow_obj" />
    </style_button>
    <style_button sound="_common_sound_button_enter" bottom_margin="12" right_margin="20" top_margin="12" left_margin="20" label_obj="label_obj" bg_obj="bg_obj" glow_obj="glow_obj" id="style_button_option_middle">
      <planeobj texture0="_common_texture_option_menu_button_middle" id="bg_obj" />
      <textobj font_size="28" bold="1" align_y="1" align_x="3" id="label_obj" />
      <planeobj texture0="_common_texture_option_menu_button_middle_glow" blend="2" id="glow_obj" />
    </style_button>
    <style_button sound="_common_sound_button_enter" bottom_margin="12" right_margin="20" top_margin="12" left_margin="20" label_obj="label_obj" bg_obj="bg_obj" glow_obj="glow_obj" id="style_button_option_bottom">
      <planeobj texture0="_common_texture_option_menu_button_bottom" id="bg_obj" />
      <textobj font_size="28" bold="1" align_y="1" align_x="3" id="label_obj" />
      <planeobj texture0="_common_texture_option_menu_button_bottom_glow" blend="2" id="glow_obj" />
    </style_button>
  </styletable>

  <texturetable>
    <texture src="texture/bg.png" id="_bg_texture" type="texture/png" />
  </texturetable>

    <templatetable>
      <template fast_open="1" id="template_list_view_generic">
        <list_view style="style_list_view_generic" id="list_view_generic">
          <layout_hint align="0, 1" size="960, 448" pos="0, -272" />
        </list_view>
      </template>

      <template fast_open="1" id="template_list_item_generic">
        <list_item style="style_list_view_item_generic" id="list_item_generic">
          <layout_hint size="960, 80" />
          <image_button sound="_common_sound_image_button" enable_long_press_text_auto_scroll="1" style="style_image_button_list_button" id="image_button_list_item">
            <focus_hint focus_shape="3" />
            <layout_hint size="840, 80" />
          </image_button>
        </list_item>
      </template>

      <template fast_open="1" id="template_top_title_bar">
        <plane style="_common_style_plane_transparent" id="plane_top">
          <layout_hint align="0, 2" size="960, 64" pos="0, 240" />
          <box style="_common_default_style_box" id="box_top">
            <layout_box space="0" align="0, 0" pos="0, 0" adjust="2, 2" layout_type="2" size="0, 0" />
            <text style="style_text_top_title_bar" auto_scroll="1" id="text_top">
              <layout_hint size="760, 0" align="0, 4" adjust="0, 2" pos="0, 0" />
            </text>
          </box>
          <plane texture="_common_texture_ruled_line" id="plane_top_separator">
            <layout_hint size="960, 2" pos="0, 0" anchor="0, 1" />
          </plane>
        </plane>
      </template>

      <template fast_open="1" id="template_host_list_item_select">
        <list_item style="style_list_view_item_generic" id="list_item_host_select">
          <layout_hint size="960, 80" />
          <image_button sound="_common_sound_image_button" enable_long_press_text_auto_scroll="1" style="style_image_button_list_button" id="image_button_host_select">
            <focus_hint focus_shape="3" />
            <layout_hint size="840, 80" />
          </image_button>
          <check_box style="_common_default_style_check_box" id="checkbox_host_select">
            <layout_hint anchor="1, 0" align="1, 0" size="58, 58" pos="92, 0" />
          </check_box>
        </list_item>
      </template>
    </templatetable>

  <stringtable>
    <locale src="locale/en.xml" compress="on" id="en" />
  </stringtable>

  <filetable>
    <file src="moonlight_settings.xml" type="application/xml" id="moonlight_settings" compress="off" />
  </filetable>
</resource>
