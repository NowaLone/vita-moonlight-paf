<?xml version="1.0" encoding="utf-8"?>
<resource version="0.1" type="normal" id="vita_moonlight_ui">

  <pagetable>
    <!--
      PAF layout is center-origin on a 960x544 plane.
      (0, 0) is the screen center. +Y is up, +X is right.
      Top of screen ≈ +272, bottom ≈ -272, left ≈ -480, right ≈ +480.
    -->
    <page id="page_main">
      <plane texture="_bg_texture" id="plane_main_bg">
        <layout_hint size="960, 544" />

        <text style="style_text_title" label="msg_moonlight_title" id="text_title">
          <layout_hint adjust="2, 2" pos="0, 170" />
        </text>

        <text style="style_text_body" label="msg_no_pcs" id="text_no_pcs">
          <layout_hint adjust="2, 2" pos="0, 90" />
        </text>

        <button sound="_common_sound_button_enter" style="_common_default_style_button" label="msg_search_pcs" id="btn_search_pcs">
          <layout_hint pos="0, 10" size="320, 72" />
        </button>

        <button sound="_common_sound_button_enter" style="_common_default_style_button" label="msg_add_manually" id="btn_add_manually">
          <layout_hint pos="0, -80" size="320, 72" />
        </button>

        <corner_button style="_common_style_corner_bottom_right" id="settings_button" />
      </plane>
    </page>

    <page id="page_search_pcs">
      <plane style="style_plane_fill" id="plane_search_fill">
        <layout_hint size="960, 544" />

        <text style="style_text_title" label="msg_search_pcs" id="text_search_title">
          <layout_hint adjust="2, 2" pos="0, 80" />
        </text>

        <text style="style_text_body" label="msg_search_pcs_description" id="text_search_description">
          <layout_hint adjust="2, 2" pos="0, 10" />
        </text>

        <corner_button style="_common_style_corner_bottom_left" id="btn_close_search" />
      </plane>
    </page>

    <page id="page_add_manually">
      <plane style="style_plane_fill" id="plane_add_manual_fill">
        <layout_hint size="960, 544" />

        <text style="style_text_title" label="msg_add_manually" id="text_add_manual_title">
          <layout_hint adjust="2, 2" pos="0, 80" />
        </text>

        <text style="style_text_body" label="msg_add_manually_description" id="text_add_manual_description">
          <layout_hint adjust="2, 2" pos="0, 10" />
        </text>

        <corner_button style="_common_style_corner_bottom_left" id="btn_close_add_manual" />
      </plane>
    </page>

    <page id="page_settings_bubble">
      <button sound="_common_sound_button_back" style="_common_default_style_button_transparent" id="btn_dismiss_balloon">
        <layout_hint size="960, 544" />
        <focus_hint enable="0" />
        <plane style="_common_default_style_plane" texture="_common_texture_option_menu_base_down" id="settings_speech_balloon">
          <layout_hint anchor="0, 1" align="0, 1" size="214, 72" pos="1920, 1080" />
          <box id="settings_balloon_box">
            <layout_box anchor="1, 2" align="1, 2" layout_type="1" bottom_margin="6" top_margin="6" right_margin="6" left_margin="6" />
            <button sound="_common_sound_button_enter" style="style_button_option_single" label="msg_settings" id="btn_settings_balloon">
              <layout_hint size="202, 60" />
            </button>
          </box>
        </plane>
      </button>
    </page>

      <plane style="_common_style_plane_transparent" id="plane_picker_root">
        <layout_hint size="960, 544" />

        <button style="style_button_clear_hit" id="btn_picker_dismiss">
          <layout_hint pos="-210, 0" size="540, 544" />
        </button>

        <plane style="style_plane_picker" id="plane_picker">
          <layout_hint pos="270, 0" size="420, 544" />

          <list_view style="_common_style_list_view_transparent" id="picker_list">
            <layout_hint pos="0, 0" size="400, 448" />
          </list_view>
        </plane>
      </plane>
    </page>
  </pagetable>

  <templatetable>
      <list_item style="_common_style_list_item_transparent" id="list_item">
        <layout_hint size="400, 64" />
        <button sound="_common_sound_button_enter" style="_style_picker_option" id="button">
          <layout_hint size="400, 64" />
          <focus_hint focus_shape="3" />
        </button>
        <plane texture="_tex_check" id="mark">
          <layout_hint pos="-168, 0" size="28, 28" />
        </plane>
      </list_item>
    </template>
  </templatetable>

  <styletable>
    <!-- Opaque cover so a stacked page hides the main-screen buttons. -->
    <style_plane color="0.063, 0.294, 0.655, 1" planeobj="plane_obj_fill" id="style_plane_fill">
      <planeobj color="0.063, 0.294, 0.655, 1" id="plane_obj_fill" />
    </style_plane>

    <style_button bg_obj="dim_hit_bg" id="style_button_dim_hit">
      <planeobj color="0, 0, 0, 0.35" id="dim_hit_bg" />
    </style_button>

    <style_button bg_obj="clear_hit_bg" id="style_button_clear_hit">
      <planeobj color="0, 0, 0, 0" id="clear_hit_bg" />
    </style_button>

    <style_plane color="0.11, 0.12, 0.14, 1" planeobj="picker_bg" id="style_plane_picker">
      <planeobj color="0.11, 0.12, 0.14, 1" id="picker_bg" />
    </style_plane>

    <style_text id="style_text_title">
      <textobj font_size="36" bold="1" color="1, 1, 1, 1" align_x="1" align_y="1" ellipsis="0" emboss="0" id="title_obj" />
    </style_text>

    <style_text id="style_text_body">
      <textobj font_size="22" bold="0" color="1, 1, 1, 0.85" align_x="1" align_y="1" word_wrap="1" ellipsis="0" emboss="0" id="body_obj" />
    </style_text>












    <style_button sound="_common_sound_button_enter" bottom_margin="12" right_margin="20" top_margin="12" left_margin="20" label_obj="label_obj" bg_obj="bg_obj" glow_obj="glow_obj" id="style_button_option_single">
      <planeobj texture0="_common_texture_option_menu_button_single" id="bg_obj" />
      <textobj font_size="28" bold="1" align_y="1" align_x="3" id="label_obj" />
      <planeobj texture0="_common_texture_option_menu_button_single_glow" blend="2" id="glow_obj" />
    </style_button>

    <style_button bottom_margin="12" glow_obj="glow_obj" right_margin="20" top_margin="12" left_margin="20" label_obj="label_obj" bg_obj="bg_obj" adjust_min_size="146, 54" id="_style_option_menu_button_middle">
      <planeobj texture0="_common_texture_option_menu_button_middle" id="bg_obj" />
      <textobj font_size="28" bold="1" align_y="1" align_x="1" adjust_x="1" adjust_y="1" id="label_obj" />
      <planeobj texture0="_common_texture_option_menu_button_middle_glow" blend="2" id="glow_obj" />
    </style_button>

    <style_button bottom_margin="12" glow_obj="glow_obj" right_margin="20" top_margin="12" left_margin="20" label_obj="label_obj" bg_obj="bg_obj" adjust_min_size="146, 54" id="_style_option_menu_button_bottom">
      <planeobj texture0="_common_texture_option_menu_button_bottom" id="bg_obj" />
      <textobj font_size="28" bold="1" align_y="1" align_x="1" adjust_x="1" adjust_y="1" id="label_obj" />
      <planeobj texture0="_common_texture_option_menu_button_bottom_glow" blend="2" id="glow_obj" />
    </style_button>

    <style_list_view color="0, 0, 0, 0" id="_common_style_list_view_transparent" sbar_v_margin="6, 6, 9" />
  </styletable>

  <texturetable>
    <texture src="texture/bg.png" id="_bg_texture" type="texture/png" />
    <texture src="texture/check.png" id="_tex_check" type="texture/png" />
    <texture src="texture/arrow.png" id="_tex_arrow" type="texture/png" />
  </texturetable>

  <stringtable>
    <locale src="locale/en.xml" compress="on" id="en" />
  </stringtable>

  <filetable>
    <file src="moonlight_settings.xml" id="moonlight_settings" compress="on" />
  </filetable>
</resource>
